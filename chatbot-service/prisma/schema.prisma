// ─────────────────────────────────────────────────────────────
// Chatbot sidecar — PostgreSQL + pgvector.
// This service does NOT own the User table (emp_id is just the
// plain int `sub` claim from the NestJS login JWT). It only owns
// its own policy/chat data, matching infradesk's chatbot schema.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PolicyDoc {
  pd_id        Int                @id @default(autoincrement())
  file_name    String?
  full_text    String?
  uploadat     DateTime?          @default(now()) @db.Timestamp(6)
  // Shared id for every file uploaded together in one request (see upload_pdf).
  // Lets "Recent Uploads" show the whole batch — 5 files or 10 — instead of a
  // fixed row count. Legacy rows from before this column existed are null.
  upload_batch String?            @db.VarChar(36)
  chunks       ChunkedPolicyDoc[]

  @@map("POLICY_DOC")
}

model ChunkedPolicyDoc {
  cpd_id      Int                    @id @default(autoincrement())
  pd_id       Int?
  chunk_index Int?
  chunk_text  String?
  // Which page of the source PDF this chunk came from (1-indexed).
  // Lets the bot cite a real, clickable page instead of a
  // model-hallucinated section reference. Null for legacy rows
  // chunked before this column existed.
  page_number Int?
  // pgvector column — 768 dims (nomic-embed-text). Managed via raw SQL
  // in the migration since Prisma can't natively type "vector".
  embedding   Unsupported("vector")?
  policy      PolicyDoc?             @relation(fields: [pd_id], references: [pd_id], onDelete: Cascade)

  @@index([embedding], map: "chunked_policy_embedding_idx")
  @@map("CHUNKED_POLICY_DOC")
}

// Abbreviation -> full term map, auto-extracted from uploaded policy PDFs
// (patterns like "Casual Leave (CL)") so the bot understands shortcuts
// like "CL"/"EL" without anyone hardcoding a fixed list. Grows automatically
// as new PDFs are uploaded; no redeploy needed.
model PolicyAbbreviation {
  id         Int       @id @default(autoincrement())
  abbr       String    @db.VarChar(20)
  full_term  String    @db.VarChar(200)
  pd_id      Int?
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([abbr, full_term])
  @@index([abbr], map: "idx_policy_abbr_abbr")
  @@map("POLICY_ABBREVIATION")
}

model ChatSession {
  id         String    @id
  title      String
  messages   Json      @default("[]")
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  emp_id     Int?

  @@index([emp_id], map: "idx_chat_sessions_emp_id")
  @@index([updated_at(sort: Desc)], map: "idx_chat_sessions_updated")
  @@map("chat_sessions")
}

model QuestionLog {
  id         Int       @id @default(autoincrement())
  question   String
  topic      String?   @default("OTHER") @db.VarChar(50)
  session_id String?   @db.VarChar(255)
  asked_at   DateTime? @default(now()) @db.Timestamp(6)

  @@map("question_logs")
}
