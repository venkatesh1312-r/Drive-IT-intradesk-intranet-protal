// ─────────────────────────────────────────────────────────────
// Chatbot sidecar — PostgreSQL + pgvector.
// This service does NOT own the User table (emp_id is just the
// plain int `sub` claim from the NestJS login JWT). It only owns
// its own policy/chat data, matching infradesk's chatbot schema.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PolicyDoc {
  pd_id     Int                @id @default(autoincrement())
  file_name String?
  full_text String?
  uploadat  DateTime?          @default(now()) @db.Timestamp(6)
  chunks    ChunkedPolicyDoc[]

  @@map("POLICY_DOC")
}

model ChunkedPolicyDoc {
  cpd_id      Int                    @id @default(autoincrement())
  pd_id       Int?
  chunk_index Int?
  chunk_text  String?
  // pgvector column — 768 dims (nomic-embed-text). Managed via raw SQL
  // in the migration since Prisma can't natively type "vector".
  embedding   Unsupported("vector")?
  policy      PolicyDoc?             @relation(fields: [pd_id], references: [pd_id], onDelete: Cascade)

  @@index([embedding], map: "chunked_policy_embedding_idx")
  @@map("CHUNKED_POLICY_DOC")
}

model ChatSession {
  id         String    @id
  title      String
  messages   Json      @default("[]")
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  emp_id     Int?

  @@index([emp_id], map: "idx_chat_sessions_emp_id")
  @@index([updated_at(sort: Desc)], map: "idx_chat_sessions_updated")
  @@map("chat_sessions")
}

model QuestionLog {
  id         Int       @id @default(autoincrement())
  question   String
  topic      String?   @default("OTHER") @db.VarChar(50)
  session_id String?   @db.VarChar(255)
  asked_at   DateTime? @default(now()) @db.Timestamp(6)

  @@map("question_logs")
}
