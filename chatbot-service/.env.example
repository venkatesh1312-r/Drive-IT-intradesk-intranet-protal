# ─────────────────────────────────────────────────────────────
# Chatbot sidecar service — environment variables
# Copy this file to .env and adjust as needed.
# ─────────────────────────────────────────────────────────────

# Port this service listens on
PORT=4000

# Where the Next.js frontend runs (for CORS)
FRONTEND_URL=http://localhost:3000

# MUST match the NestJS backend's JWT_SECRET so the login token validates here
JWT_SECRET="your-super-secret-jwt-key-change-this"

# PostgreSQL + pgvector. Needs the `vector` extension available in the
# target database (CREATE EXTENSION vector; — run once, needs superuser
# the first time). Can be the same Postgres server as the main backend,
# but keep it a separate database/schema — this service does not touch
# the main backend's tables.
DATABASE_URL="postgresql://user:password@localhost:5432/driveit_chatbot"

# Ollama (local) — used ONLY for embeddings now (nomic-embed-text).
# Chat answers are generated by Groq, not Ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Groq (cloud) — powers question classification, follow-up detection,
# and the actual streamed chat answers. Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Python guardrails + LangGraph microservice (input toxicity/injection
# check + post-stream output guard). Run separately:
#   cd python-microservice && uvicorn main:app --port 8000
# If unreachable, input validation and output guard fail OPEN (skipped),
# so the chatbot still works without this — guardrails just won't run.
PYTHON_SERVICE_URL=http://localhost:8000

# Set to "true" to log per-request timing/classifier debug output
DEBUG_TIMERS=false
