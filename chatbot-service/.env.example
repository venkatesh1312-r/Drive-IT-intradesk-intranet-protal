# ─────────────────────────────────────────────────────────────
# Chatbot sidecar service — environment variables
# Copy this file to .env and adjust as needed.
# ─────────────────────────────────────────────────────────────

# Port this service listens on
PORT=4000

# Where the Next.js frontend runs (for CORS)
FRONTEND_URL=http://localhost:3000

# MUST match the NestJS backend's JWT_SECRET so the login token validates here
JWT_SECRET=driveit-super-secret-jwt-key-2024

# SQLite database file (self-contained — no Postgres/pgvector needed)
DATABASE_URL="file:./chatbot.db"

# Ollama (local) — used for BOTH embeddings and the chat LLM
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# Pull a chat model first, e.g.  ollama pull llama3.2
OLLAMA_LLM_MODEL=llama3.2

# Optional Python guardrails microservice. If unreachable, the pipeline
# fails open (skips guardrails) — so this is not required.
PYTHON_SERVICE_URL=http://localhost:8001
