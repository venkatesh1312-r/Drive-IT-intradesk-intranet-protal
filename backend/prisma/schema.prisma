generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  HR
  IT
  ADMIN
}

enum UserStatus {
  AWAITING_APPROVAL
  ACTIVE
  REJECTED
}

enum NominationStatus {
  PENDING
  ESCALATED
  APPROVED
  DECLINED
}

enum NominationCategory {
  EXCELLENCE
  COLLABORATION
  INNOVATION
  CUSTOMER_IMPACT
  LEADERSHIP
}

enum Department {
  IT
  HR
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
  REASSIGNED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VisitorRelation {
  CLIENT
  INTERVIEWEE
  VENDOR
  PARTNER
  OTHER
}

enum VisitStatus {
  SCHEDULED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum ContributionType {
  FEATURE
  BUG_FIX
  IMPROVEMENT
  DOCUMENTATION
  MEETING
  OTHER
}

model User {
  id              Int                 @id @default(autoincrement())
  name            String
  email           String              @unique
  // Nullable: new signups have no role until an admin assigns one.
  role            Role?
  status          UserStatus          @default(AWAITING_APPROVAL)
  // ── OTP login (legacy, kept for backward compatibility; unused by password flow) ──
  otpHash         String?
  otpExpiresAt    DateTime?
  otpAttempts     Int                 @default(0)
  lastOtpSentAt   DateTime?
  // ── Sign-up OTP (email verification gate before the details/password step) ──
  otpVerified     Boolean             @default(false)
  // ── Password login ──
  passwordHash        String?
  // Reused for both first-time "set password" (signup activation) links and
  // "forgot password" links — same mechanism, same token lifecycle.
  passwordTokenHash    String?
  passwordTokenExpires DateTime?
  lastPasswordEmailAt  DateTime?
  department      Department?
  designation     String?
  points          Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt
  nominations     Nomination[]        @relation("SubmittedBy")
  raisedTickets   Ticket[]            @relation("RaisedBy")
  assignedTickets Ticket[]            @relation("AssignedTo")
  closedTickets   Ticket[]            @relation("ClosedBy")
  comments        Comment[]
  auditLogs       AuditLog[]
  notifications   InAppNotification[]
  createdVisits   Visit[]             @relation("VisitCreatedBy")
  hostedVisits    Visit[]             @relation("VisitHost")
  projectMemberships ProjectMember[]
  workLogEntries  WorkLogEntry[]
  workLogComments WorkLogComment[]
}

model Nomination {
  id            Int                @id @default(autoincrement())
  projectName   String
  nomineeName   String
  nominatedBy   String
  category      NominationCategory
  context       String
  status        NominationStatus   @default(PENDING)
  points        Int?
  submittedById Int
  submittedBy   User               @relation("SubmittedBy", fields: [submittedById], references: [id])
  createdAt     DateTime           @default(now())
}

model Ticket {
  id             Int                 @id @default(autoincrement())
  ticketNumber   String              @unique
  title          String
  description    String              @db.Text
  status         TicketStatus        @default(OPEN)
  priority       TicketPriority      @default(MEDIUM)
  department     Department
  isBlocked      Boolean             @default(false)
  blockedReason  String?
  blockedAt      DateTime?
  resolutionNote String?             @db.Text
  resolvedAt     DateTime?
  closedAt       DateTime?
  claimedAt      DateTime?
  assignedAt     DateTime?
  closedById     Int?
  closedBy       User?               @relation("ClosedBy", fields: [closedById], references: [id])
  raisedById     Int
  raisedBy       User                @relation("RaisedBy", fields: [raisedById], references: [id])
  assignedToId   Int?
  assignedTo     User?               @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  comments       Comment[]
  auditLogs      AuditLog[]
  notifications  InAppNotification[]

  @@index([status])
  @@index([department])
  @@index([assignedToId])
}

model Comment {
  id        Int       @id @default(autoincrement())
  message   String    @db.Text
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  ticketId  Int
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id])
  createdAt DateTime  @default(now())

  @@index([ticketId])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  changeType   String
  fieldChanged String?
  oldValue     String?
  newValue     String?
  createdAt    DateTime @default(now())
}

model Visitor {
  id           Int      @id @default(autoincrement())
  visitId      Int
  visit        Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  phone        String
  govtIdNumber String?
  createdAt    DateTime @default(now())

  @@map("visitors")
}

model Visit {
  id                   Int         @id @default(autoincrement())
  visitorCompany       String
  numberOfVisitors     Int
  purpose              String
  hostId               Int?
  host                 User?       @relation("VisitHost", fields: [hostId], references: [id])
  hostName             String
  visitors             Visitor[]
  scheduledDate        DateTime
  expectedCheckInTime  String
  expectedCheckOutTime String
  status               VisitStatus @default(SCHEDULED)
  notes                String?     @db.Text
  cancellationNote     String?     @db.Text
  isWalkIn             Boolean     @default(false)
  isRescheduled        Boolean     @default(false)
  actualArrivalTime    DateTime?
  checkoutTime         DateTime?
  cancelledAt          DateTime?
  cancelledBy          String?
  createdById          Int
  createdBy            User        @relation("VisitCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([status])
  @@index([scheduledDate])
  @@map("visits")
}

model InAppNotification {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  ticketId      Int?
  ticket        Ticket?  @relation(fields: [ticketId], references: [id])
  ticketNumber  String?
  ticketTitle   String?
  message       String
  actionRequired String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, isRead])
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
  workLogEntries WorkLogEntry[]
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// Intentionally has no hours/duration/start-end fields — Work Log tracks
// what was done, not how long it took.
model WorkLogEntry {
  id               Int               @id @default(autoincrement())
  employeeId       Int
  employee         User              @relation(fields: [employeeId], references: [id])
  projectId        Int
  project          Project           @relation(fields: [projectId], references: [id])
  entryDate        DateTime          @db.Date
  contributionType ContributionType
  description      String            @db.Text
  link             String?
  tags             String[]          @default([])
  edited           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  comments         WorkLogComment[]

  @@index([employeeId, entryDate])
  @@index([projectId, entryDate])
}

model WorkLogComment {
  id        Int          @id @default(autoincrement())
  entryId   Int
  entry     WorkLogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User         @relation(fields: [authorId], references: [id])
  message   String
  createdAt DateTime     @default(now())

  @@index([entryId])
}
