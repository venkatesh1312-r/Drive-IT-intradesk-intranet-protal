generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  HR
  IT
  ADMIN
}

enum NominationStatus {
  PENDING
  ESCALATED
  APPROVED
  DECLINED
}

enum NominationCategory {
  EXCELLENCE
  COLLABORATION
  INNOVATION
  CUSTOMER_IMPACT
  LEADERSHIP
}

enum Department {
  IT
  HR
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
  REASSIGNED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VisitorRelation {
  CLIENT
  INTERVIEWEE
  VENDOR
  PARTNER
  OTHER
}

enum VisitStatus {
  SCHEDULED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model User {
  id              Int                 @id @default(autoincrement())
  name            String
  email           String              @unique
  password        String
  role            Role                @default(EMPLOYEE)
  department      Department?
  designation     String?
  points          Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt
  nominations     Nomination[]        @relation("SubmittedBy")
  raisedTickets   Ticket[]            @relation("RaisedBy")
  assignedTickets Ticket[]            @relation("AssignedTo")
  closedTickets   Ticket[]            @relation("ClosedBy")
  comments        Comment[]
  auditLogs       AuditLog[]
  notifications   InAppNotification[]
  createdVisits   Visit[]             @relation("VisitCreatedBy")
  hostedVisits    Visit[]             @relation("VisitHost")
}

model Nomination {
  id            Int                @id @default(autoincrement())
  projectName   String
  nomineeName   String
  nominatedBy   String
  category      NominationCategory
  context       String
  status        NominationStatus   @default(PENDING)
  points        Int?
  submittedById Int
  submittedBy   User               @relation("SubmittedBy", fields: [submittedById], references: [id])
  createdAt     DateTime           @default(now())
}

model Ticket {
  id             Int                 @id @default(autoincrement())
  ticketNumber   String              @unique
  title          String
  description    String              @db.Text
  status         TicketStatus        @default(OPEN)
  priority       TicketPriority      @default(MEDIUM)
  department     Department
  isBlocked      Boolean             @default(false)
  blockedReason  String?
  blockedAt      DateTime?
  resolutionNote String?             @db.Text
  resolvedAt     DateTime?
  closedAt       DateTime?
  claimedAt      DateTime?
  assignedAt     DateTime?
  closedById     Int?
  closedBy       User?               @relation("ClosedBy", fields: [closedById], references: [id])
  raisedById     Int
  raisedBy       User                @relation("RaisedBy", fields: [raisedById], references: [id])
  assignedToId   Int?
  assignedTo     User?               @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  comments       Comment[]
  auditLogs      AuditLog[]
  notifications  InAppNotification[]

  @@index([status])
  @@index([department])
  @@index([assignedToId])
}

model Comment {
  id        Int       @id @default(autoincrement())
  message   String    @db.Text
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  ticketId  Int
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id])
  createdAt DateTime  @default(now())

  @@index([ticketId])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  changeType   String
  fieldChanged String?
  oldValue     String?
  newValue     String?
  createdAt    DateTime @default(now())
}

model Visitor {
  id           Int      @id @default(autoincrement())
  visitId      Int
  visit        Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  phone        String
  govtIdNumber String?
  createdAt    DateTime @default(now())

  @@map("visitors")
}

model Visit {
  id                   Int         @id @default(autoincrement())
  visitorCompany       String
  numberOfVisitors     Int
  purpose              String
  hostId               Int?
  host                 User?       @relation("VisitHost", fields: [hostId], references: [id])
  hostName             String
  visitors             Visitor[]
  scheduledDate        DateTime
  expectedCheckInTime  String
  expectedCheckOutTime String
  status               VisitStatus @default(SCHEDULED)
  notes                String?     @db.Text
  cancellationNote     String?     @db.Text
  isWalkIn             Boolean     @default(false)
  isRescheduled        Boolean     @default(false)
  actualArrivalTime    DateTime?
  checkoutTime         DateTime?
  cancelledAt          DateTime?
  cancelledBy          String?
  createdById          Int
  createdBy            User        @relation("VisitCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([status])
  @@index([scheduledDate])
  @@map("visits")
}

model InAppNotification {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  ticketId      Int?
  ticket        Ticket?  @relation(fields: [ticketId], references: [id])
  ticketNumber  String?
  ticketTitle   String?
  message       String
  actionRequired String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, isRead])
}
