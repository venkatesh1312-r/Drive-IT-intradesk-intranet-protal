DATABASE_URL="postgresql://postgres:password@localhost:5432/driveit_rewards"
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"
PORT=3001

# ── Bootstrap admin (seed) ─────────────────────────────────────────
# Must match firstname.initial@driveittech.in or OTP login will reject it.
BOOTSTRAP_ADMIN_EMAIL=admin.a@driveittech.in
BOOTSTRAP_ADMIN_NAME="Portal Admin"

# ── OTP email delivery (SMTP via nodemailer) ───────────────────────
# Leave SMTP_HOST empty in dev — OTPs are then logged to the backend console.
#
# ZOHO MAIL (custom domain driveittech.in):
#   • Datacenter matters: India account → smtp.zoho.in, global → smtp.zoho.com
#   • Port 465 (SSL) or 587 (STARTTLS). 465 is the most reliable with Zoho.
#   • SMTP_USER must be a REAL, existing Zoho mailbox you own.
#   • SMTP_PASS must be an APP-SPECIFIC PASSWORD if 2FA is on (Zoho →
#     My Account → Security → App Passwords), NOT your normal login password.
#   • SMTP_FROM must equal SMTP_USER (or a verified alias) or Zoho drops it.
#     If you leave SMTP_FROM blank, the app uses SMTP_USER automatically.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=no-reply@driveittech.in
SMTP_PASS=your-zoho-app-specific-password
SMTP_FROM="DriveIT Portal <no-reply@driveittech.in>"
